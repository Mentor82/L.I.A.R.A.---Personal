# ==================== DATABASE ====================
DATABASE_URL=postgresql://liara:your_password@localhost:5432/liara
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ==================== AI MODELS ====================
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3.2:latest

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Stable Diffusion WebUI (Optional - für lokale Bild-Generierung)
# Installation: https://github.com/AUTOMATIC1111/stable-diffusion-webui
# Start: ./webui.sh --api --listen
# Privacy-First: Alle Daten bleiben auf dem Server
SD_WEBUI_URL=http://localhost:7860
SD_OUTPUT_DIR=/opt/liara/app/generated_images

# ==================== SECURITY ====================
SECRET_KEY=generate-a-secure-random-string-here
JWT_SECRET_KEY=generate-another-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== FRONTEND ====================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ==================== SEARCH (Optional) ====================
TAVILY_API_KEY=tvly-your-tavily-key-here

# ==================== EMAIL (Optional) ====================
# Für eigene Domain (z.B. mw-dresden.de)
SMTP_HOST=mail.mw-dresden.de
SMTP_PORT=587
SMTP_USER=liara@mw-dresden.de
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=liara@mw-dresden.de
FROM_NAME=Liara AI Assistant
FRONTEND_URL=https://liara.mw-dresden.de

# Alternative SMTP-Provider:
# - INWX: smtp.inwx.de (wenn E-Mail-Hosting bei INWX)
# - Self-Hosted: localhost:25 (eigener Mailserver)
# - Gmail App-Passwort-Guide nur für Tests/temporär:
#   1. Google Account → Security → 2-Step Verification
#   2. App Passwords → Generate
#   3. Use generated password for SMTP_PASSWORD

# ==================== ENVIRONMENT ====================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
